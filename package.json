{
  "name": "anvil-engineering-workbench",
  "version": "1.4.0",
  "author": "Aditya Tiwari <m.g.atiwari28@gmail.com> (https://github.com/AdityaaaTiwari)",
  "contributors": [
    "Aditya Tiwari <m.g.atiwari28@gmail.com> (https://github.com/AdityaaaTiwari)"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "ANVIL — An open-source AI engineering harness with codebase intelligence, review history, regression signals, and a local engineering dashboard.",
  "type": "module",
  "bin": {
    "anvil": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/server.d.ts",
      "import": "./dist/mcp/server.js"
    }
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "tsx scripts/measure-token-footprint.ts",
    "eval:harness": "tsx scripts/agent-eval-harness.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.api.json && prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"api/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"api/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"api/**/*.ts\"",
    "test:coverage": "vitest run --coverage",
    "dashboard": "node dist/cli.js dashboard .",
    "dashboard:dev": "tsx src/cli.ts dashboard .",
    "mcp": "node dist/mcp/server.js",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ai",
    "developer-tools",
    "engineering",
    "code-quality",
    "workflows",
    "doctor",
    "cleaner",
    "autofix",
    "architecture-map",
    "mcp-server"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "prettier": "^3.10.1",
    "tsx": "^4.19.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "typescript": "^5.8.3",
    "zod": "^4.2.0"
  },
  "files": [
    "dist",
    "catalog",
    "skills",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anvil-workbench/ANVIL.git"
  }
}